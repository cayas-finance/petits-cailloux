{
  "name": "petits-cailloux",
  "private": true,
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "start": "npm run db:migrate:local && npm run build && wrangler dev --port 8787",
    "build": "npm run build -w web",
    "dev:web": "npm start -w web",
    "dev:api": "npm run dev -w api",
    "db:generate": "npm run db:generate -w api",
    "db:migrate:local": "wrangler d1 migrations apply petits-cailloux --local",
    "db:reset:local": "rm -rf .wrangler/state && npm run db:migrate:local",
    "db:migrate:remote": "wrangler d1 migrations apply petits-cailloux --remote",
    "test": "npm test -w api",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "volta": {
    "node": "24.22.3"
  }
}
