// A single Worker serves the Angular UI (static assets) and the API (/api/*).
// No secrets here: the repository is public. ACCESS_TEAM_DOMAIN and ACCESS_AUD
// are set in the Cloudflare dashboard (Worker variables).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petits-cailloux",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "web/dist/web/browser",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_DOMAIN": "cayas.fr"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petits-cailloux",
      // À remplacer par l'identifiant affiché par `npx wrangler d1 create petits-cailloux`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "api/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      // À créer avec `npx wrangler r2 bucket create petits-cailloux-attachments`
      "bucket_name": "petits-cailloux-attachments"
    }
  ],
  "observability": { "enabled": true }
}
