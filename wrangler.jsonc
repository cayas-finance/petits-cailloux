// A single Worker serves the Angular UI (static assets), the API (/api/*) and the
// MCP server for AI clients (/mcp, with its OAuth endpoints): see api/src/worker.ts.
// No secrets here: the repository is public. ACCESS_TEAM_DOMAIN and ACCESS_AUD
// are set in the Cloudflare dashboard (Worker variables); keep_vars stops a
// deploy from erasing them. The D1 database and the R2 bucket are found by
// name, so their account identifiers stay out of the repository.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petits-cailloux",
  "main": "api/src/worker.ts",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  // Outbound fetches only reach public addresses: required to read MCP clients' metadata safely.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // No public URL per version: only the production URL, behind Access.
  "preview_urls": false,
  "assets": {
    "directory": "web/dist/web/browser",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/authorize", "/token", "/register", "/.well-known/*"]
  },
  "vars": {
    "ALLOWED_DOMAIN": "cayas.fr"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petits-cailloux",
      "migrations_dir": "api/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "petits-cailloux-attachments"
    }
  ],
  "kv_namespaces": [
    {
      // OAuth grants and tokens of the MCP server, created on the first deploy.
      "binding": "OAUTH_KV"
    }
  ],
  "observability": { "enabled": true }
}
