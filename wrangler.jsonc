// Un seul Worker sert l'interface Angular (fichiers statiques) et l'API (/api/*).
// Aucun secret ici : le dépôt est public. ACCESS_EQUIPE et ACCESS_AUD se règlent
// dans le tableau de bord Cloudflare (Variables du Worker).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petits-cailloux",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "web/dist/web/browser",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "DOMAINE_AUTORISE": "cayas.fr"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petits-cailloux",
      // À remplacer par l'identifiant affiché par `npx wrangler d1 create petits-cailloux`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "api/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FICHIERS",
      // À créer avec `npx wrangler r2 bucket create petits-cailloux-fichiers`
      "bucket_name": "petits-cailloux-fichiers"
    }
  ],
  "observability": { "enabled": true }
}
